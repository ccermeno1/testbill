# --- environment and caches --------------------------------------------------
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.ruff_cache/
*.egg-info/
build/
dist/

# --- editor and operating system ---------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- data --------------------------------------------------------------------
# This branch serves; the dataset lives on `main`'s machines, not here.
data/

# --- runs --------------------------------------------------------------------
# A served run is `runs/<name>/{run.json, config.yaml, metrics.json, weights/}`
# and it IS versioned (the weights through Git LFS, see .gitattributes).
# What training left beside it stays out.
runs/**/_train/
runs/**/viz/
runs/_inspection/
runs/test_evaluations.jsonl

# Stray checkpoints anywhere else (a download, an Ultralytics leftover).
*.pt
*.pth
*.onnx
*.tflite
!runs/**/weights/*
